---
import type { Post } from "../lib/posts";
import { formatDay, readingMinutes } from "../lib/posts";
import Arrow from "./Arrow.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const latest = posts.slice(0, 3);
---

<section class="band band-sunk" id="writing" aria-labelledby="writing-title">
  <p class="kicker">III · {posts.length} posts</p>
  <h2 id="writing-title" class="display">Writing</h2>
  {
    posts.length === 0 ? (
      <p class="empty">
        First posts coming soon. <a href="/rss.xml">RSS</a>
      </p>
    ) : (
      <ol class="writing-list">
        {latest.map((post) => (
          <li>
            <a class="post-row" href={`/blog/${post.id}`}>
              <span class="mono" data-vt={`date-${post.id}`}>{formatDay(post.data.date)}</span>
              <span class="post-title" data-vt={`post-${post.id}`}>{post.data.title}</span>
              <span class="post-meta">{post.data.summary}</span>
              <span class="mono">{readingMinutes(post.body)} min</span>
            </a>
          </li>
        ))}
      </ol>
    )
  }
  <p><a href="/blog">All writing <Arrow /></a></p>
</section>
