---
import faultRuns from "../data/fault-runs.json";
import tests from "../data/incident-tests.json";
import evalData from "../data/log-forensics-eval.json";
import evalRaw from "../data/log-forensics-eval.json?raw";
import Stamp from "./Stamp.astro";
import { incidentPlain } from "../content/copy";
import { incidentMilestones, incidentRepo } from "../content/links";
import { incidentNotes } from "../content/measured";
import { incidentDiagram } from "../lib/diagram";
import { stemChart, type ChartRow } from "../lib/chart";
import { formatInt } from "../lib/format";

const wallRows: ChartRow[] = faultRuns.map((row) => ({
  label: row.fault,
  lines: row.fault.split("_"),
  value: Number(row.wall_seconds),
  display: `${row.wall_seconds} s`,
}));
const slowest = Math.max(...wallRows.map((row) => row.value));
for (const row of wallRows) row.accent = row.value === slowest;

const perFault = Object.entries(evalData.per_fault);
const diagram = incidentDiagram();
---

<hr class="project-rule" />
<p class="plain" id="incident">{incidentPlain[0]}</p>
<p class="plain">{incidentPlain[1]}</p>
<h3 class="project-title">Multi-agent incident responder</h3>
<p>
  <a href={incidentRepo}>incident-responder</a>
</p>
<p>
  This is a Python simulation of a microservice outage. Gateway, orders, inventory, and payments
  emit OpenTelemetry traces, logs, and metrics. A fault injector plants four faults as real commits
  in a sample service history, so git blame can find them. It is the base for a multi-agent
  root-cause system. Milestones 1 and 2 are built. The later agents are not.
</p>
<p>{incidentNotes.faultDecision}</p>
<p>{incidentNotes.selfTime}</p>
<p>Tradeoff: {incidentNotes.clockTradeoff}</p>

<h3 class="role-title">Milestones</h3>
{
  incidentMilestones.map((row) => (
    <p class="milestone">
      <Stamp status={row.status} />
      {row.name}
      {row.detail ? ` ${row.detail}` : ""}{" "}
      {row.pr ? <a href={row.pr}>PR #{row.pr.split("/").pop()}</a> : null}
    </p>
  ))
}
<p class="note">
  Status is per milestone. Code Archaeologist, the runbook agent, the RCA report, and the README
  with a demo are planned, not shipped.
</p>

<figure class="figure">
  <div aria-hidden="true" set:html={diagram} />
  <figcaption>Fig. 4 — Incident responder. Planned nodes are dashed and labeled.</figcaption>
</figure>

<figure class="figure">
  <div aria-hidden="true" set:html={stemChart(wallRows)} />
  <div class="sr-only">
  <table>
    <caption>Fault scenario wall time in seconds</caption>
    <tbody>
      {
        faultRuns.map((row) => (
          <tr>
            <th scope="row">{row.fault}</th>
            <td>{row.wall_seconds} s</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  </div>
  <figcaption>Fig. 5 — Fault scenario wall time, seconds</figcaption>
</figure>
<p class="note">{incidentNotes.runNote}</p>

<div class="table-scroll">
<table>
  <caption class="table-caption">Telemetry from each fault run</caption>
  <thead>
    <tr>
      <th scope="col">Fault</th>
      <th scope="col">Spans</th>
      <th scope="col">Logs</th>
      <th scope="col">Metrics</th>
      <th scope="col">Traces</th>
      <th scope="col">Log bytes</th>
      <th scope="col">Metric bytes</th>
      <th scope="col">Truth</th>
    </tr>
  </thead>
  <tbody>
    {
      faultRuns.map((row) => (
        <tr>
          <th scope="row">{row.fault}</th>
          <td>{row.spans}</td>
          <td>{row.logs}</td>
          <td>{row.metric_points}</td>
          <td>{formatInt(row.traces_bytes)}</td>
          <td>{formatInt(row.logs_bytes)}</td>
          <td>{formatInt(row.metrics_bytes)}</td>
          <td>{row.ground_truth_bytes}</td>
        </tr>
      ))
    }
  </tbody>
</table>
</div>
<p class="note">fault-runs.json. Byte columns are traces, logs, metrics, and the ground-truth file. {incidentNotes.runNote}</p>

<table>
  <caption class="table-caption">Pytest runs</caption>
  <thead>
    <tr>
      <th scope="col">Record</th>
      <th scope="col">Passed</th>
      <th scope="col">Seconds</th>
    </tr>
  </thead>
  <tbody>
    {
      tests.map((row) => (
        <tr>
          <th scope="row">{row.milestone}</th>
          <td>{row.tests_passed}</td>
          <td>{row.seconds}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p class="note">tests-by-milestone.csv. These are the recorded runs, not a sum of the two rows.</p>

<p>
  The Log Forensics eval ran {evalData.cases} cases ({evalData.faults} faults, seeds {evalData.seeds.join(", ")}).
  {evalData.correct_service} of {evalData.cases} named the right service. Onset error was {evalData.onset_error_ms_max} ms.
  Citations resolved: {evalData.citations_resolved}. Runtime {evalData.runtime_seconds} s. Tokens in: {evalData.tokens_in}.
  Tokens out: {evalData.tokens_out}. LLM called: {String(evalData.llm_called)}.
</p>
<p>{incidentNotes.llmOff}</p>
<p class="note">
  {evalData.note} {incidentNotes.shortBlips}
</p>

<table>
  <caption class="table-caption">Eval result by fault</caption>
  <thead>
    <tr>
      <th scope="col">Fault</th>
      <th scope="col">Service</th>
      <th scope="col">Correct</th>
    </tr>
  </thead>
  <tbody>
    {
      perFault.map(([fault, row]) => (
        <tr>
          <th scope="row">{fault}</th>
          <td>{row.service}</td>
          <td>{row.correct}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p class="note">log-forensics-eval.json. {incidentNotes.evalEasy}</p>
<pre><code>{evalRaw.trim()}</code></pre>
<p class="note">Eval record, copied as stored.</p>
