---
---

<div class="on-air" data-now-playing data-state="off">
  <button class="air-main" type="button" popovertarget="now-pop" aria-label="What is playing">
    <span class="air-tag" data-air-label>Off air</span>
    <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="air-track" data-air-track>Radio silence. Back soon.</span>
  </button>
  <a class="air-link mono" data-air-url href="https://open.spotify.com" hidden>on Spotify</a>
</div>
<div id="now-pop" class="now-pop" popover>
  <img data-art alt="" width="64" height="64" decoding="async" hidden />
  <p data-pop-title></p>
  <p data-pop-by></p>
  <p data-pop-album></p>
  <a data-pop-link href="https://open.spotify.com">Listen on Spotify</a>
  <p class="mono">Spotify</p>
</div>
