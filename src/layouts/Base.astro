---
import "../styles/global.css";
import fraunces from "../fonts/fraunces.woff2";
import OnAir from "../components/OnAir.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { email, github, intro, linkedin } from "../content/site";

interface Props {
  title?: string;
  description?: string;
  progress?: boolean;
  jsonLd?: boolean;
}

const {
  title = "Taamir Khan",
  description = intro,
  progress = false,
  jsonLd = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://taamir.dev").href;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Taamir Khan",
  url: "https://taamir.dev/",
  email: `mailto:${email}`,
  jobTitle: "Software Engineer II",
  worksFor: { "@type": "Organization", name: "Argo Data" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of Connecticut" },
  sameAs: [github, linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F2EEE3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121914" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.dataset.theme=t;var h=sessionStorage.getItem("hue");if(h&&/^-?\d+$/.test(h)){var n=Math.max(-25,Math.min(25,parseInt(h,10)||0));if(n)document.documentElement.style.setProperty("--hue-shift",String(n));if(String(n)!==h)sessionStorage.setItem("hue",n?String(n):"0")}}catch(e){}
      document.documentElement.classList.add("js")
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://taamir.dev/og.svg" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Writing" href="/rss.xml" />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="sticky">
      <OnAir />
      {progress && <div class="read-progress" aria-hidden="true"></div>}
      <Header />
    </div>
    <div class="page">
      <main id="content" tabindex="-1">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
