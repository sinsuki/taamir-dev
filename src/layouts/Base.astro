---
import "../styles/global.css";
import newsreaderRoman from "../fonts/newsreader-roman.woff2";
import { email, github, linkedin } from "../content/links";
import { introSentence } from "../content/copy";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Taamir Khan", description = introSentence } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Taamir Khan",
  url: "https://taamir.dev/",
  email: `mailto:${email}`,
  jobTitle: "Software Engineer II",
  worksFor: { "@type": "Organization", name: "Argo Data" },
  alumniOf: { "@type": "CollegeOrUniversity", name: "University of Connecticut" },
  sameAs: [github, linkedin],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F5F0E6" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.setAttribute("data-theme", theme);
          document.documentElement.classList.add("js");
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#171512" : "#F5F0E6");
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://taamir.dev/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://taamir.dev/" />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={newsreaderRoman} as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <div class="shell">
      <header class="mast">
        <a class="wordmark" href="#top">Taamir Khan</a>
        <nav aria-label="Sections">
          <a href="#about">About</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#play">Play</a>
          <a href="#contact">Contact</a>
        </nav>
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">
          <span class="when-light">Dark</span>
          <span class="when-dark">Light</span>
        </button>
      </header>
      <main id="content">
        <slot />
      </main>
      <footer class="colophon">
        <slot name="footer" />
      </footer>
    </div>
    <dialog id="shortcuts" aria-labelledby="shortcuts-title">
      <h2 id="shortcuts-title">Shortcuts</h2>
      <ul>
        <li><kbd>?</kbd> Open or close this list</li>
        <li><kbd>g</kbd> then <kbd>p</kbd> Projects</li>
        <li><kbd>g</kbd> then <kbd>c</kbd> Contact</li>
        <li><kbd>t</kbd> Theme</li>
        <li><kbd>Esc</kbd> Close</li>
      </ul>
      <button id="shortcuts-close" type="button">Close</button>
    </dialog>
    <script>
      import { initSite } from "../scripts/site";
      initSite();
    </script>
  </body>
</html>
