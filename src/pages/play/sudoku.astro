---
import Base from "../../layouts/Base.astro";
---

<Base title="Daily Sudoku · Play" description="One puzzle a day, with pencil marks and hints that name the technique.">
  <article class="play-desk block">
    <header data-vt="obj-sudoku">
      <p class="kicker">No. 01</p>
      <h1 class="display">Daily Sudoku</h1>
      <p>One puzzle for this calendar day. Arrows move. 1–9 fills a cell. Pencil marks the candidates.</p>
    </header>
    <div class="sudoku-layout">
      <div id="board" class="sudoku" role="grid" aria-label="Sudoku"></div>
      <div class="sudoku-side">
        <p class="toy-controls">
          <button type="button" class="toy-button" id="pencil" aria-pressed="false">Pencil: off</button>
          <button type="button" class="toy-button" id="hint">Hint</button>
        </p>
        <p id="note" aria-live="polite"></p>
      </div>
    </div>
    <p><a href="/#play">Back to the shelf</a></p>
  </article>
</Base>
<script>
  import { dailyPuzzle, hint, solved } from "../../lib/sudoku.mjs";

  const day = new Date();
  const key = `sudoku-${day.getFullYear()}-${day.getMonth() + 1}-${day.getDate()}`;
  const givens = dailyPuzzle(day);
  let values = givens.slice();
  let marks: number[][] = Array.from({ length: 81 }, () => []);
  let pencil = false;
  let cursor = 0;
  try {
    const saved = JSON.parse(localStorage.getItem(key) || "");
    if (Array.isArray(saved.values) && saved.values.length === 81) values = saved.values;
    if (Array.isArray(saved.marks)) marks = saved.marks;
  } catch { /* a fresh puzzle */ }
  const board = document.getElementById("board")!;
  const note = document.getElementById("note")!;
  const cells: HTMLButtonElement[] = [];

  function save() {
    try { localStorage.setItem(key, JSON.stringify({ values, marks })); } catch { /* stays on the page */ }
  }
  function paint() {
    cells.forEach((button, index) => {
      const given = givens[index] !== 0;
      button.replaceChildren();
      if (values[index]) button.textContent = String(values[index]);
      else if (marks[index]?.length) {
        const small = document.createElement("span");
        small.className = "marks";
        small.textContent = marks[index].join("");
        button.append(small);
      }
      button.toggleAttribute("data-given", given);
      const row = Math.floor(index / 9) + 1;
      const col = (index % 9) + 1;
      const digit = values[index] ? `, ${values[index]}` : "";
      button.setAttribute("aria-label", given ? `Row ${row} column ${col}${digit}, given` : `Row ${row} column ${col}${digit}`);
      button.tabIndex = index === cursor ? 0 : -1;
      button.removeAttribute("data-hint");
    });
    note.textContent = solved(values) ? "Solved." : "";
  }
  function focus(index: number) {
    cursor = (index + 81) % 81;
    cells[cursor].focus();
    paint();
  }
  for (let row = 0; row < 9; row += 1) {
    const rowEl = document.createElement("div");
    rowEl.setAttribute("role", "row");
    for (let col = 0; col < 9; col += 1) {
      const index = row * 9 + col;
      const button = document.createElement("button");
      button.type = "button";
      button.setAttribute("role", "gridcell");
      button.setAttribute("aria-label", `Row ${row + 1} column ${col + 1}`);
      button.addEventListener("focus", () => { cursor = index; });
      button.addEventListener("click", () => focus(index));
      button.addEventListener("keydown", (event) => {
        const keyName = event.key;
        if (keyName === "ArrowRight") focus(index + 1);
        else if (keyName === "ArrowLeft") focus(index - 1);
        else if (keyName === "ArrowDown") focus(index + 9);
        else if (keyName === "ArrowUp") focus(index - 9);
        else if (/^[1-9]$/.test(keyName)) place(index, Number(keyName));
        else if (keyName === "Backspace" || keyName === "Delete" || keyName === "0") place(index, 0);
        else return;
        event.preventDefault();
      });
      cells.push(button);
      rowEl.append(button);
    }
    board.append(rowEl);
  }
  function place(index: number, digit: number) {
    if (givens[index]) return;
    if (pencil && digit) {
      const list = new Set(marks[index] ?? []);
      if (list.has(digit)) list.delete(digit);
      else list.add(digit);
      marks[index] = [...list].sort();
      values[index] = 0;
    } else {
      values[index] = digit;
      marks[index] = [];
    }
    save();
    paint();
  }
  const pencilButton = document.getElementById("pencil") as HTMLButtonElement;
  pencilButton.addEventListener("click", () => {
    pencil = !pencil;
    pencilButton.setAttribute("aria-pressed", String(pencil));
    pencilButton.textContent = pencil ? "Pencil: on" : "Pencil: off";
  });
  document.getElementById("hint")!.addEventListener("click", () => {
    const next = hint(values);
    paint();
    if (!next) {
      note.textContent = "No single I can name from here.";
      return;
    }
    cells[next.index].setAttribute("data-hint", "");
    note.textContent = next.text;
  });
  paint();
</script>
