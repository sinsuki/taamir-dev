---
import Base from "../layouts/Base.astro";
import Contact from "../components/Contact.astro";
import Hero from "../components/Hero.astro";
import Ledger from "../components/Ledger.astro";
import Plate from "../components/Plate.astro";
import Shelf from "../components/Shelf.astro";
import Writing from "../components/Writing.astro";
import { guardrail, incident, projects } from "../content/projects";
import { shelfItems, showShelf } from "../content/site";
import { getPublished } from "../lib/posts";

const posts = await getPublished();
---

<Base jsonLd>
  <Hero />
  <Ledger />
  <section class="block" id="projects" aria-labelledby="projects-title">
    <p class="kicker">II · {projects.length} builds</p>
    <h2 id="projects-title" class="display">Projects</h2>
    <Plate project={guardrail} />
    <Plate project={incident} />
  </section>
  <Writing posts={posts} />
  {showShelf && <Shelf items={shelfItems} />}
  <Contact />
</Base>
